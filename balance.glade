<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="balance_window">
    <property name="title">ATM - View Balance</property>
    <property name="default-width">400</property>
    <property name="default-height">300</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">20</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Your Balance</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="balance_label">
            <property name="visible">True</property>
            <property name="label">Your current balance is: $0.00</property>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Back</property>
            <signal name="clicked" handler="show_window" object="menu_window" swapped="yes"/>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>