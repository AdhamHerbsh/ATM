<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="welcome_window">
    <property name="title">ATM - Welcome</property>
    <property name="default-width">400</property>
    <property name="default-height">300</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">20</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Welcome to the ATM</property>
            <attributes>
              <attribute name="weight" value="bold"/>
              <attribute name="scale" value="1.5"/>
            </attributes>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Create Account</property>
            <signal name="clicked" handler="show_window" object="create_account_window" swapped="yes"/>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Login</property>
            <signal name="clicked" handler="show_window" object="login_window" swapped="yes"/>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Exit</property>
            <signal name="clicked" handler="on_exit_clicked" swapped="no"/>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>