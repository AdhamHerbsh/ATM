<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="withdraw_window">
    <property name="title">ATM - Withdraw</property>
    <property name="default-width">400</property>
    <property name="default-height">300</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">20</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Withdraw Funds</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Amount ($):</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="withdraw_amount_entry">
            <property name="visible">True</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkButton">
                <property name="visible">True</property>
                <property name="label">Withdraw</property>
                <signal name="clicked" handler="on_withdraw_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="visible">True</property>
                <property name="label">Back</property>
                <signal name="clicked" handler="show_window" object="menu_window" swapped="yes"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>