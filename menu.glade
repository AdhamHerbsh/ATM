<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="menu_window">
    <property name="title">ATM - Main Menu</property>
    <property name="default-width">400</property>
    <property name="default-height">300</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">20</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">ATM Menu</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">View Balance</property>
            <signal name="clicked" handler="on_view_balance_clicked" swapped="no"/>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Withdraw</property>
            <signal name="clicked" handler="show_window" object="withdraw_window" swapped="yes"/>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Deposit</property>
            <signal name="clicked" handler="show_window" object="deposit_window" swapped="yes"/>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="visible">True</property>
            <property name="label">Logout</property>
            <signal name="clicked" handler="on_logout_clicked" swapped="no"/>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>