<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="create_account_window">
    <property name="title">ATM - Create Account</property>
    <property name="default-width">400</property>
    <property name="default-height">300</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">20</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Create New Account</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Name:</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="create_name_entry">
            <property name="visible">True</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">PIN (4 digits):</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="create_pin1_entry">
            <property name="visible">True</property>
            <property name="max-length">4</property>
            <property name="visibility">False</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Confirm PIN:</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="create_pin2_entry">
            <property name="visible">True</property>
            <property name="max-length">4</property>
            <property name="visibility">False</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkButton">
                <property name="visible">True</property>
                <property name="label">Create</property>
                <signal name="clicked" handler="on_create_account_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="visible">True</property>
                <property name="label">Back</property>
                <signal name="clicked" handler="show_window" object="welcome_window" swapped="yes"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>